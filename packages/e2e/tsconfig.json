{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `.ts` specifiers: Node and tsx run src/ without a build, and nothing is emitted.
    "allowImportingTsExtensions": true,
    // Resolve @battleship/core and @battleship/server from their sources (D22).
    "customConditions": ["@battleship/source"],
    // The client's text constants are imported from its sources, which follow the client's settings: extensionless
    // specifiers, Angular's decorators and the DOM.
    "experimentalDecorators": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "journeys", "playwright.config.ts", "../client/src/build-defines.d.ts"]
}
