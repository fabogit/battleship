# Copy to .env for local runs (`pnpm --filter @battleship/server start`); on Render these come from the dashboard.
PORT=3000
# Comma-separated browser origins allowed over HTTP and Socket.io. Requests without an Origin header are always allowed.
# `https://*.<project>.pages.dev` admits every Cloudflare Pages preview (exactly one subdomain label, https only).
ALLOWED_ORIGINS=http://localhost:4200
# `pretty` for readable local logs (pino-pretty, dev dependency); unset or `json` on Render.
LOG_FORMAT=pretty
# `debug` also logs /health and every socket event with its payload; unset (`info`) on Render.
LOG_LEVEL=debug
