{
  "name": "@battleship/server",
  "version": "0.0.0",
  "private": true,
  "description": "Authoritative Fastify + Socket.io game server",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
