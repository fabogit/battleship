{
  "name": "@battleship/server",
  "version": "0.0.0",
  "private": true,
  "description": "Authoritative Fastify + Socket.io game server",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx watch --clear-screen=false --conditions=@battleship/source --env-file-if-exists=.env src/index.ts",
    "echo": "node scripts/echo-client.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@battleship/core": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "socket.io": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
