# Copy to .env (`cp .env.example .env`): read by `ng serve` (`pnpm dev`, `start`) and by builds (`pnpm build`,
# `pnpm verify`) through scripts/ng.ts; on Cloudflare Pages and in CI it comes from the environment, which wins over
# this file. https:// is required, except http:// to localhost, 127.0.0.1 or [::1]. `ng test` does not read it.
# The local server (packages/server/.env, PORT=3000).
SERVER_URL=http://localhost:3000
