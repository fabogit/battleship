{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "build: server",
      "cwd": "${workspaceFolder}/packages/server",
      "runtimeArgs": ["--env-file-if-exists=.env"],
      "program": "${workspaceFolder}/packages/server/dist/index.js",
      "outFiles": ["${workspaceFolder}/packages/{core,server}/dist/**/*.js"],
      // Ctrl+C in this terminal reaches node alone, so the graceful shutdown runs (D27).
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Client",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "serve: client",
      "url": "http://localhost:4200",
      // Source maps list `src/...` relative to the Angular project.
      "webRoot": "${workspaceFolder}/packages/client",
      // Any installed Chrome or Chromium: js-debug ranks a plain `chromium` as "custom", not "stable".
      "runtimeExecutable": "*"
    },
    {
      "name": "Server tests: current file",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/packages/server",
      "program": "${workspaceFolder}/packages/server/node_modules/vitest/vitest.mjs",
      "args": ["run", "${file}"],
      "autoAttachChildProcesses": true,
      "smartStep": true,
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Client tests: current file",
      "type": "node",
      "request": "attach",
      "preLaunchTask": "test: client (debug current file)",
      "port": 9229,
      // `ng test --debug` waits on the first line until a debugger attaches.
      "continueOnAttach": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ],
  "compounds": [
    {
      "name": "Server + Client",
      "configurations": ["Server", "Client"],
      "stopAll": true
    }
  ]
}
