{
  "tasks": [
    {
      "label": "build: server",
      "command": "pnpm --filter @battleship/server... build",
      "detail": "tsc build of core and server, for the Server launch configuration",
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "label": "serve: client",
      "command": "pnpm --filter @battleship/client start",
      "detail": "ng serve on http://localhost:4200, against the local server",
      "isBackground": true,
      "problemMatcher": {
        "background": {
          "beginsPattern": { "regexp": "Building|Changes detected" },
          "endsPattern": { "regexp": "bundle generation (complete|failed)" }
        },
        "owner": "angular",
        "pattern": "$tsc"
      },
      "type": "shell"
    },
    {
      "label": "test: client (debug current file)",
      "command": "pnpm --filter @battleship/client exec ng test --no-watch --debug --include '${file}'",
      "detail": "ng test --debug on the open spec; waits for a debugger on port 9229",
      "isBackground": true,
      "problemMatcher": {
        "background": {
          "beginsPattern": { "regexp": "Building" },
          "endsPattern": { "regexp": "Debugger listening on" }
        },
        "owner": "angular",
        "pattern": "$tsc"
      },
      "type": "shell"
    }
  ],
  "version": "2.0.0"
}
