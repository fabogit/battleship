{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "all",
  "overrides": [
    {
      "files": "packages/client/**/*.html",
      "options": { "parser": "angular" }
    },
    {
      "files": "*.md",
      "options": { "embeddedLanguageFormatting": "off" }
    }
  ]
}
